# Copy to .env and adjust. docker compose reads .env automatically.
# All values here are for LOCAL DEVELOPMENT only.

# PostgreSQL superuser used by every service (one database per service is created on first start)
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminpassword

# HS256 secret shared by users (signs JWTs on login/register) and the gateway (validates them).
# Must be at least 32 bytes.
# Generate one with: openssl rand -base64 48
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789
