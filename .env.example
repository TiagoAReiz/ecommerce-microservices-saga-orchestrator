# Copy to .env and adjust. docker compose reads .env automatically.
# All values here are for LOCAL DEVELOPMENT only.

# PostgreSQL superuser used by every service (one database per service is created on first start)
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminpassword

# HS256 secret shared by users (signs JWTs on login/register) and the gateway (validates them).
# Must be at least 32 bytes.
# Generate one with: openssl rand -base64 48
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789

# Token lifetimes (users service). Short access tokens bound how long a token stays usable after
# logout/revocation, because the gateway validates access tokens without calling the users service.
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Comma-separated e-mails that get the ADMIN role on registration/login/refresh. Empty = no admins.
# E-mails are not verified: register the account first, then list its e-mail here (see README).
ADMIN_EMAILS=
